<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Gives bindaru's root helper (pkexec /usr/bin/bindaru helper) a clear password message.
     auth_admin, never _keep: each install or remove asks once; nothing else can reuse it. -->
<policyconfig>
  <vendor>bindaru</vendor>
  <vendor_url>https://github.com/asafelobotomy/bindaru</vendor_url>
  <action id="io.github.asafelobotomy.bindaru.apply">
    <description>Install or remove packages with bindaru</description>
    <message>bindaru needs administrator rights to install or remove packages.</message>
    <icon_name>bindaru</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/bindaru</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">helper</annotate>
  </action>
</policyconfig>
